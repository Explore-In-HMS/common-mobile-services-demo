<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeScreen">

    <fragment
        android:id="@+id/homeScreen"
        android:name="huawei.cmsdemo.main.ui.home.HomeScreen"
        android:label="fragment_home_screen"
        tools:layout="@layout/fragment_home_screen" >
        <action
            android:id="@+id/action_homeScreen_to_adsScreen"
            app:destination="@id/adsScreen" />
        <action
            android:id="@+id/action_homeScreen_to_mapScreen"
            app:destination="@id/mapScreen" />
        <action
            android:id="@+id/action_homeScreen_to_accountScreen"
            app:destination="@id/accountScreen" />
        <action
            android:id="@+id/action_homeScreen_to_authScreen"
            app:destination="@id/authScreen" />
        <action
            android:id="@+id/action_homeScreen_to_translateScreen"
            app:destination="@id/translateScreen" />
    </fragment>
    <fragment
        android:id="@+id/adsScreen"
        android:name="huawei.cmsdemo.main.ui.ads.AdsScreen"
        android:label="fragment_ads_screen"
        tools:layout="@layout/fragment_ads_screen" />
    <fragment
        android:id="@+id/mapScreen"
        android:name="huawei.cmsdemo.main.ui.map.MapScreen"
        android:label="fragment_map_screen"
        tools:layout="@layout/fragment_map_screen" />
    <fragment
        android:id="@+id/accountScreen"
        android:name="huawei.cmsdemo.main.ui.account.AccountScreen"
        android:label="fragment_account_screen"
        tools:layout="@layout/fragment_account_screen" />
    <fragment
        android:id="@+id/authScreen"
        android:name="huawei.cmsdemo.main.ui.auth.AuthScreen"
        android:label="fragment_auth_screen"
        tools:layout="@layout/fragment_auth_screen" />
    <fragment
        android:id="@+id/translateScreen"
        android:name="huawei.cmsdemo.main.ui.translate.TranslateScreen"
        android:label="fragment_translate_screen"
        tools:layout="@layout/fragment_translate_screen" />
</navigation>